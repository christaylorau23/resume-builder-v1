# Required for JD → PDF (AI redraft). Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=REDACTED_ANTHROPIC_KEY

# Optional: server and CORS (defaults shown)
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=dev-secret-change-in-production

# Optional: Canva OAuth (for "Connect Canva" in the web app)
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_TEMPLATE_ID=
# CANVA_ACCESS_TOKEN=  # From OAuth flow; paste after "Connect Canva" (see docs/canva-oauth-setup.md)

# Optional: Firecrawl API key for scraping job URLs (Job URL tab). Get one at https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-8763420416264c3097da93c5ab649bd4
