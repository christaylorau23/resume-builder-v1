# Telegram (optional – for scripts/notify.ts factory updates to your phone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Canva OAuth (for "Connect Canva" in the web app). Create a Connect app at Canva Developer Portal.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Canva CLI export (for `pnpm run redraft --export canva`).
# Access token: obtain via the web app OAuth flow, or paste from Canva Dev Portal sandbox.
# Template ID: the design to inject into (defaults to the MVP template DAHCRCTTohk).
CANVA_ACCESS_TOKEN=
CANVA_TEMPLATE_ID=DAHCRCTTohk

# API server (when running apps/api)
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=
